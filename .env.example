# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Timeout for OpenAI calls in ms (default 30000)
OPENAI_TIMEOUT_MS=30000

# ── Anthropic (Urdu script generation) ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Azure Speech TTS ──────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# ── App config ────────────────────────────────────────────────────────────────
# Urdu TTS master switch — audio generation is skipped unless 'true'
URDU_TTS_ENABLED=true
# Persist generated Urdu TTS text to qa_cache
SAVE_URDU_TTS=true
# Q&A + audio cache kill-switch — set 'true' to enable caching
CACHE_ENABLED=false
# Optional gate for /api/chat2 + /api/topic-view (middleware) — leave unset to disable
DEMO_ACCESS_KEY=your-demo-access-key-here
# Key for /api/admin/* routes (falls back to DEMO_ACCESS_KEY if unset)
ADMIN_KEY=your-admin-key-here
